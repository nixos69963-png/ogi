# agent reads this file from the working directory, then from its parent, and
# stops at the first one found. Real environment variables win over both. Inside
# another project that parent file is that project's .env, so `agent config` is
# worth running once after any move. Every line here is optional.

# --- model -------------------------------------------------------------------
# Any tag this daemon can serve. A `:cloud` tag is billed by the provider, not free.
AGENT_MODEL=gemma4:31b-cloud
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- workspace ---------------------------------------------------------------
# Default is the directory you run from. Everything outside it is refused
# unless AGENT_ALLOW_OUTSIDE is set, and that is a deliberate act, not a default.
# AGENT_WORKSPACE=D:\workstation\my-project
AGENT_ALLOW_OUTSIDE=false
# Secret files (.env, private keys, credential stores) are refused. Opening this
# turns off the only protection between the model and your passwords.
AGENT_ALLOW_SECRETS=false

# --- size of a run -----------------------------------------------------------
# Working time in minutes. Empty = no clock, and the run is bounded by turns alone
# (80). A budget is a floor as well as a ceiling: it keeps going while time remains.
AGENT_BUDGET_MINUTES=
# One tool result never enters the transcript bigger than this many characters.
AGENT_MAX_OBSERVE_CHARS=12000
# Transcript budget in tokens, and the share at which it is compacted.
AGENT_CONTEXT_TOKENS=60000
AGENT_COMPACT_AT_PERCENT=0.75

# --- approvals ---------------------------------------------------------------
# The tier: how much runs before the agent stops for you.
#   ask  — every write and every outward step asks first (the default)
#   auto — routine writes and plain commands run; anything risky still asks
#   full — every write inside the project runs unasked
# The tier never moves the floor. These stop at every level: a step that reaches
# the machine (registry, services, a global install, a path outside the project),
# a file that cannot be re-created (manifest, lockfile, .env, .git), and anything
# another person would see. With nobody watching, a stopped step is refused.
AGENT_APPROVAL_LEVEL=ask
# The older switch, kept working: off means auto, on means ask. The tier above
# wins when both are set.
AGENT_APPROVALS=on

# --- browser -----------------------------------------------------------------
# Chrome is found on its own if installed. Set this for Edge, Brave, or a
# headless shell. Ports at or below 1024 are ignored in favour of the default —
# the DevTools port is the one thing that must not be a privileged port.
# AGENT_BROWSER_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
AGENT_BROWSER_PORT=9333
# Its own profile: no sign-ins, no cookies from your daily browser.
# AGENT_BROWSER_PROFILE=D:\workstation\a\cli\.agent\browser-profile
AGENT_BROWSER_HEADLESS=false

# --- github ------------------------------------------------------------------
# A fine-grained PAT, scoped to the repositories you name, with a month expiry.
# Leave it blank to keep GitHub read-only. Never put this in a command line:
# github_push passes it through the environment, so it stays out of argv, the
# process list, the log and .git/config.
GITHUB_TOKEN=
# Default owner/name for github_issue, github_issues, github_ci, github_comment
# and github_pr. Empty means every one of those calls must pass repo: itself.
# github_push is different: it pushes the workspace's own git remote and needs neither.
GITHUB_REPO=

# --- mcp ---------------------------------------------------------------------
# Servers are in ~/.agent/mcp.json (user, trusted) and .mcp.json in a project
# (untrusted until `agent mcp approve <name>`). These two switches are read from
# the real environment, not from this file:
#   AGENT_MCP=0                 run without connecting any MCP server
#   AGENT_MCP_TRUST_PROJECT=1   run project servers without approval — this
#                               trusts whatever a repository ships, so never
#                               leave it on.

# --- shell and display -------------------------------------------------------
# Path to bash.exe when it is not on PATH (Git for Windows installs it here):
# AGENT_BASH=C:\Program Files\Git\bin\bash.exe
# Print the model's reasoning as it streams. The REPL has no command for this;
# it is set at launch, because the transcript layout changes with it.
AGENT_SHOW_THINKING=0
AGENT_FORCE_COLOR=0

# --- tests -------------------------------------------------------------------
# Scratch root for the suite. Default is the system temp directory.
# AGENT_TEST_TMP=D:\tmp\agent-cli-tests
